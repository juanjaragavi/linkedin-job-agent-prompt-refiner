[TEMPLATE]
# Required: Anthropic Console API key
ANTHROPIC_API_KEY=

# Required only when using NVIDIA models: NVIDIA build API key (for
# https://integrate.api.nvidia.com/v1).
NVIDIA_API_KEY=

# Select models available to your account. Any registry model ID works and
# its provider is derived automatically (see /api/models for the full list).
# Default: Claude Haiku 4.5 (claude-haiku-4-5-20251001) — Anthropic's fastest
# model, released 2025-10-15. Swap in any model ID your account can access;
# the evaluator can use a stronger model than the refiner if you prefer.
PROMPT_REFINER_MODEL=claude-haiku-4-5-20251001
PROMPT_EVALUATOR_MODEL=claude-haiku-4-5-20251001

# Provider for each role: "anthropic" or "nvidia". Only needed to force a
# provider for a custom model ID not listed in the registry; registry models
# pick their provider automatically from the model ID.
PROMPT_REFINER_PROVIDER=anthropic
PROMPT_EVALUATOR_PROVIDER=anthropic

# Set to true to request thinking/reasoning output on NVIDIA Nemotron-family
# models (chat_template_kwargs.enable_thinking). This is passed EXPLICITLY in
# both directions: when false (default), the model is told not to emit a
# reasoning preamble into `delta.content` — that narration would corrupt the
# refiner's section parsing. Reasoning tokens in `delta.reasoning_content` are
# discarded by the client either way.
NVIDIA_ENABLE_THINKING=false

# Maximum accepted candidate prompt length.
PROMPT_MAX_LENGTH=50000

# Per-request timeout (ms) and retry count for the LLM APIs. The SDK defaults
# (10 min, 2 retries) can make a slow request look frozen for 30+ minutes;
# these fail loudly instead. Raise PROMPT_REFINER_TIMEOUT_MS if a legitimate
# run times out.
PROMPT_REFINER_TIMEOUT_MS=180000
PROMPT_REFINER_MAX_RETRIES=1

# Max output tokens per request. The refiner must reproduce the full ~39k-char
# active prompt in its response, so 8000 was too small and truncated output
# caused silent rejections. Default 20000 (Haiku 4.5 supports up to 64k).
PROMPT_REFINER_MAX_TOKENS=20000
