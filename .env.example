# Required: Anthropic Console API key
ANTHROPIC_API_KEY=

# Select models available to your Anthropic account.
# Default: Claude Haiku 4.5 (claude-haiku-4-5-20251001) — Anthropic's fastest
# model, released 2025-10-15. Swap in any model ID your account can access;
# the evaluator can use a stronger model than the refiner if you prefer.
PROMPT_REFINER_MODEL=claude-haiku-4-5-20251001
PROMPT_EVALUATOR_MODEL=claude-haiku-4-5-20251001

# Maximum accepted candidate prompt length.
PROMPT_MAX_LENGTH=50000

# Per-request timeout (ms) and retry count for the Anthropic API. The SDK's
# defaults (10 min, 2 retries) can make a slow request look frozen for 30+
# minutes; these fail loudly instead. Raise PROMPT_REFINER_TIMEOUT_MS if a
# legitimate run times out.
PROMPT_REFINER_TIMEOUT_MS=180000
PROMPT_REFINER_MAX_RETRIES=1

# Max output tokens per request. The refiner must reproduce the full ~39k-char
# active prompt in its response, so 8000 was too small and truncated output
# caused silent rejections. Default 20000 (Haiku 4.5 supports up to 64k).
PROMPT_REFINER_MAX_TOKENS=20000
