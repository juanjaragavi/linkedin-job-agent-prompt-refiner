{
  "name": "linkedin-job-agent-prompt-refiner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Safety-gated refinement loop for Juan's LinkedIn job-search assistant system prompt.",
  "scripts": {
    "prompt:refine": "tsx src/prompt-refinement/cli.ts",
    "prompt:check": "tsx src/prompt-refinement/check.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mcp:serve": "tsx src/mcp-server/index.ts",
    "serve": "tsx src/server/index.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
